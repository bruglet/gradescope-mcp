# Copy this file to ~/.config/gradescope-mcp/gradescope-mcp.env and chmod 600.
# Replace every placeholder with a real value. Never commit the copied file.
GRADESCOPE_EMAIL=student@example.edu
GRADESCOPE_PASSWORD=replace-with-gradescope-password
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-cloudflare-access-audience

# Do not set LOCAL_AUTH_BYPASS in the deployed container.
